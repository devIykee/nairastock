# ─────────────────────────────────────────────────────────────────────────────
# NairaStock environment
#
# Copy to `.env` at the repo root:   cp .env.example .env
# Every var below has a documented default in apps/api/src/config/env.schema.ts;
# the API refuses to boot with a readable error if a required one is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4010
# Comma-separated list of browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database (matches docker-compose.yml defaults) ───────────────────────────
POSTGRES_USER=nairastock
POSTGRES_PASSWORD=nairastock
POSTGRES_DB=nairastock
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://nairastock:nairastock@localhost:5433/nairastock?schema=public

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380

# ── Auth ─────────────────────────────────────────────────────────────────────
# 32+ chars. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
JWT_EXPIRES_IN=7d
# Login nonces expire this fast (seconds) to bound signature replay.
AUTH_NONCE_TTL_SECONDS=300

# ── Mnemonic encryption at rest ──────────────────────────────────────────────
# HACKATHON DEMO ONLY. The API encrypts custodial demo mnemonics with
# AES-256-GCM under a scrypt-stretched key from this secret. A production build
# never sees the mnemonic at all (WalletConnect / client-side signing).
# Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=dev-only-change-me-1111111111111111111111111111111111111111111111

# ── Chain ────────────────────────────────────────────────────────────────────
# 31337 = local anvil (default dev target), 84532 = Base Sepolia, 8453 = Base mainnet.
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
EXPLORER_BASE_URL=http://localhost:8545
# Deployed by `pnpm chain:deploy` (writes these back into .env automatically).
MULTICALL3_ADDRESS=
DEX_ROUTER_ADDRESS=
DEX_FACTORY_ADDRESS=

# Faucet / demo liquidity account. anvil account #0 — a well-known public test
# key. NEVER put a key with real funds here.
FAUCET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── Tokens (filled in by `pnpm chain:deploy`) ────────────────────────────────
CNGN_ADDRESS=
AAPLC_ADDRESS=
NVDAC_ADDRESS=
METAC_ADDRESS=
GOOGLC_ADDRESS=

# Chainlink-compatible aggregators. On local/Sepolia these are mock aggregators
# deployed by `pnpm chain:deploy` and nudged by the pricing job's random walk.
# On Base mainnet, replace with the real Chainlink feed addresses.
AAPLC_FEED_ADDRESS=
NVDAC_FEED_ADDRESS=
METAC_FEED_ADDRESS=
GOOGLC_FEED_ADDRESS=

# ── Pricing ──────────────────────────────────────────────────────────────────
# Fixed USD→NGN rate. Production pulls this from an FX oracle / Busha-Quidax rate API.
NGN_USD_RATE=1600
PRICE_POLL_INTERVAL_MS=30000
PRICE_CACHE_TTL_SECONDS=120
# When true the pricing job walks the mock aggregators so the demo chart moves.
PRICE_SIMULATION_ENABLED=true

# ── Swap ─────────────────────────────────────────────────────────────────────
DEFAULT_SLIPPAGE_BPS=100
MAX_SLIPPAGE_BPS=5000
SWAP_DEADLINE_SECONDS=600
SWAP_CONFIRMATIONS=1

# ── Onramp (mocked naira rail) ───────────────────────────────────────────────
ONRAMP_MIN_NGN=1000
ONRAMP_MAX_NGN=50000000

# ── Frontend (apps/web reads these at build time via Vite) ───────────────────
VITE_API_BASE_URL=http://localhost:4010/api
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_EXPLORER_BASE_URL=http://localhost:8545
VITE_NETWORK_LABEL=Local Anvil
