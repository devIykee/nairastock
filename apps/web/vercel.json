{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm install && pnpm --filter @nairastock/web build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "echo 'Handled by buildCommand'",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
