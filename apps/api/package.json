{
  "name": "@nairastock/api",
  "version": "0.1.0",
  "private": true,
  "description": "NairaStock backend — wallet, swap, pricing, portfolio",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "prisma:seed": "dotenv -e ../../.env -- ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@nairastock/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.2",
    "@nestjs/common": "11.0.12",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.12",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.0.12",
    "@nestjs/swagger": "11.1.0",
    "@nestjs/terminus": "11.0.0",
    "@prisma/client": "6.5.0",
    "bip39": "3.1.0",
    "bullmq": "5.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "ethers": "6.13.5",
    "ioredis": "5.6.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.5",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "11.0.12",
    "@types/express": "5.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.2",
    "dotenv-cli": "8.0.0",
    "jest": "29.7.0",
    "prisma": "6.5.0",
    "supertest": "7.1.0",
    "ts-jest": "29.2.6",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3"
  }
}
